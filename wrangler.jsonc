{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "worksheet-master-generator-v52",
  "main": "src/index.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}